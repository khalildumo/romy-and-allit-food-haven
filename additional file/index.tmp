
<?php
require __DIR__ . '/db.php';
$menuProducts = $pdo->query("SELECT id, name, category, description, price, image_path FROM menu_products WHERE is_available = 1 ORDER BY FIELD(category, 'mains', 'breakfast', 'drinks'), name")->fetchAll();
?>
