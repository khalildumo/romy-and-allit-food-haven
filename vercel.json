{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm install --legacy-peer-deps --no-audit",
    "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/(favicon\\.ico|robots\\.txt)",
            "dest": "/public/$1"
        },
        {
            "src": "/(assets|build)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "DB_CONNECTION": "mysql",
        "DB_PORT": "3306",
        "DB_CHARSET": "utf8mb4",
        "DB_COLLATION": "utf8mb4_unicode_ci",
        "SESSION_DRIVER": "cookie",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "MAIL_MAILER": "smtp",
        "MAIL_SCHEME": "smtp",
        "MAIL_HOST": "smtp.gmail.com",
        "MAIL_PORT": "587"
    }
}
